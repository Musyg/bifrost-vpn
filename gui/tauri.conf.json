{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bifrost",
  "version": "0.1.0",
  "identifier": "io.github.musyg.bifrost-vpn",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Bifrost",
        "width": 440,
        "height": 400,
        "resizable": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "publisher": "Bifrost",
    "icon": ["target/gen-icons/icon.png"]
  }
}
